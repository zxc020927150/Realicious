				transform: translateX(-100%);
			}
		}

		/* 全寬容器 */
		.marquee-full-width {
			width: 100vw;
			position: relative;
			left: 50%;
			right: 50%;
			margin-left: -50vw;
			margin-right: -50vw;
			overflow: hidden;
			white-space: nowrap;
			padding: 10px 0;
