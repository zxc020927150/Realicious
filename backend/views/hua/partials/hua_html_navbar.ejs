<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">YumWay ლ(´ڡ`ლ)</a>
    
    <div class="ms-auto">
      <% if (loginUser) { %>
        <!-- 登入後顯示 -->
        <span class="navbar-text me-3">
          歡迎，<strong><%= loginUser.account %></strong>
        </span>
        <!-- 登出按鈕：加上 onclick 做二次確認 -->
        <a href="/login/logout" class="btn btn-outline-danger" 
          onclick="return confirm('確定要登出嗎？')">登出</a>
      <% } else { %>
        <!-- 未登入顯示 -->
        <span class="navbar-text me-3">尚未登入</span>
        <a href="/login" class="btn btn-primary">登入</a>
      <% } %>
    </div>
    </div>
