<link
	href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
	rel="stylesheet"
/>
<style>
	.navbar-nav a.nav-link.active {
		border-radius: 5px;
		background-color: #0d6efd;
		color: white;
		font-weight: 800;
	}

	.navbar-brand {
		font-family: "Fira Sans", sans-serif;
		font-weight: 600;
		font-style: normal;
		font-size: 1.5rem;
	}
</style>

<nav class="navbar navbar-expand-lg bg-body-tertiary">
	<div class="container-fluid">
		<a class="navbar-brand" href="/">YumWay ლ(´ڡ`ლ)</a>
		<button
			class="navbar-toggler"
			type="button"
			data-bs-toggle="collapse"
			data-bs-target="#navbarSupportedContent"
			aria-controls="navbarSupportedContent"
			aria-expanded="false"
			aria-label="Toggle navigation"
		>
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarSupportedContent">
			<ul class="navbar-nav me-auto mb-2 mb-lg-0">
				<li class="nav-item">
					<a
						class="nav-link <%= pageName === 'articles-list' ? 'active' : '' %>"
						href="/articles/list"
						>文章管理</a
					>
				</li>
				<li class="nav-item">
					<a
						class="nav-link <%= pageName === 'articles-announcement' ? 'active' : '' %>"
						href="/articles/announcement"
						>公告管理</a
					>
				</li>
				<li class="nav-item">
					<a
						class="nav-link <%= pageName === 'articles-categories' ? 'active' : '' %>"
						href="/articles/categories"
						>類別管理</a
					>
				</li>
				<li class="nav-item">
					<a
						class="nav-link <%= pageName === 'articles-report' ? 'active' : '' %>"
						href="/articles/report"
						>檢舉管理</a
					>
				</li>
			</ul>
			<button class="btn btn-primary myThemeBtn" onclick="toggleTheme()">
				暗或亮
			</button>
		</div>
	</div>
</nav>

<script>
	function toggleTheme() {
		const html = document.querySelector("html");
		const theme = html.getAttribute("data-bs-theme");
		const newTheme = theme === "dark" ? "light" : "dark";

		html.setAttribute("data-bs-theme", newTheme);
		localStorage.setItem("theme", newTheme); // 保存到 localStorage
	}
</script>
