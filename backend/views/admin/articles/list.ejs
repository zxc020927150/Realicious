<%- include('../../partials/articles/html-head.ejs') %>
<%- include('../../partials/articles/html-navbar.ejs') %>
<style>
    .container_table{
        margin-top: 20px;
    }
</style>
<div class="container mt-3">
    <h2 class="m-0">文章列表</h2>
	<div class="row">
		<div class="col">
			<nav aria-label="Page navigation example"></nav>
		</div>
	</div>

    <div class="container_table mt-2">
	<div class="row">
		<div class="col">
			<table class="table table-striped table-bordered">
				<thead>
					<tr>
						<th>#</th>
						<th>作者</th>
						<th>帳號</th>
						<th>標題</th>
						<th>文章內容</th>
						<th>建立時間</th>
						<th>更新時間</th>
                        <th>置頂</th>
						<th>隱藏</th>
					</tr>
				</thead>
				<tbody>
                    <% for(let a of articles){ %>
                        <tr>
                        <td><%= a.id %></td>
                        <td><%= a.author %></td>
                        <td><%= a.account %></td>
                        <td><%= a.title %></td>
                        <td><%= a.content %></td>
                        <td><%= a.created_at %></td>
                        <td><%= a.updated_at %></td>
                        <td>
                        <% if(a.pin == 1) {%>
                            <i class="fa-solid fa-thumbtack pin-icon text-primary" data-id="<%= a.id %>" data-pin="<%= a.pin %>"></i>
                        <%} else {%>
                            <i class="fa-solid fa-thumbtack pin-icon text-secondary" style="opacity: 0.5;" data-id="<%= a.id %>" data-pin="<%= a.pin %>"></i>
                        <% } %>
                        </td>
                        <td>
                        <% if(a.hide == 1) {%>
                        <i class="fa-solid fa-eye-slash hide-icon" data-id="<%= a.id %>" data-hide="<%= a.hide %>"></i>
                        <%} else {%>
                            <i class="fa-solid fa-eye hide-icon" data-id="<%= a.id %>" data-hide="<%= a.hide %>"></i>
                        <% } %>
                        </td>
                    </tr>
                    <% } %>
				</tbody>
			</table>
		</div>
	</div>
    </div>
</div>
<script>
    document.addEventListener("click", async (e) => {
    const icon = e.target.closest(".pin-icon");
    if (!icon) return;

    const id = Number(icon.dataset.id);
    const pin = Number(icon.dataset.pin);
    const newPin = pin === 1 ? 0 : 1;
    
    const res = await fetch(`/articles/list/pin`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ is_pinned: newPin, articleId: id })
    });
    const data = await res.json();

    if (data.success) {
        location.reload();
    }
});


// ======= 隱藏欄位 ======= //
 document.addEventListener("click", async (e) => {
    const hide_icon = e.target.closest(".hide-icon");
    if (!hide_icon) return;

    const id = Number(hide_icon.dataset.id);
    const hide = Number(hide_icon.dataset.hide);
    const newHide = hide === 1 ? 0 : 1;
    
    const res = await fetch(`/articles/list/hide`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: newHide, articleId: id })
    });
    const data = await res.json();

    if (data.success) {
        location.reload();
    }
});
</script>

<%- include('../../partials/articles/html-scripts.ejs') %>
<%- include('../../partials/articles/html-tail.ejs') %>
